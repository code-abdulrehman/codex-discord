# ---- Discord bot (create at https://discord.com/developers/applications) ----
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_client_id_here
DISCORD_CLIENT_SECRET=your_oauth2_client_secret_here

# Public URL of the web server. For a remote box use https or an ngrok tunnel.
# Redirect URI must be <PUBLIC_BASE_URL>/auth/discord/callback in the Discord OAuth2 settings.
# Discord requires localhost redirect URIs to be exactly:
#   http://localhost:<HTTP_PORT>/auth/discord/callback
PUBLIC_BASE_URL=http://localhost:3456
DISCORD_REDIRECT_URI=http://localhost:3456/auth/discord/callback

HTTP_PORT=3456

# Comma-separated Discord user IDs allowed to log in. Leave empty to allow anyone.
ALLOWED_DISCORD_IDS=

# ---- Codex app-server ----
# Path to the codex binary (defaults to `codex` from PATH).
CODEX_BIN=codex
# Codex home directory (defaults to ~/.codex). Must be logged in: run `codex login`.
# CODEX_HOME=/Users/you/.codex

# Where codex tasks run by default (when no cwd is given).
DEFAULT_CWD=/Users/you/your-project

# Approval policy:
#   on-request   ask approval only when codex decides an action needs it (default, less noisy)
#   untrusted    ask approval for every command / file change (the full Discord-approval experience)
#   never        auto-approve everything (no Discord notifications)
APPROVAL_POLICY=on-request

# Sandbox: read-only | workspace-write | danger-full-access
SANDBOX=workspace-write

# Optional model override (defaults to codex's default model for your account).
# CODEX_MODEL=gpt-5.1-codex-mini

# Data directory for users / sessions / tasks (defaults to ./data).
# DATA_DIR=./data

# ---- Terminal integration: `codex-discord run "<prompt>"` ----
# Needed only if you want to start tasks from your terminal instead of Discord.
# CLI_SECRET: any shared secret (keep it secret — it lets the CLI start tasks).
# DEFAULT_DISCORD_USER_ID: your Discord user id (Enable "Developer Mode" in Discord,
# right-click your name -> Copy User ID). Approvals/results for terminal tasks go here.
CLI_SECRET=change-me
DEFAULT_DISCORD_USER_ID=